<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{ title }} — Md Abdul Munim</title>
    <meta name="description" content="{{ description or 'A blog post by Md Abdul Munim' }}" />
    {% if canonical %}<link rel="canonical" href="{{ canonical }}" />{% else %}<link rel="canonical" href="https://itsmunim.github.io{{ page.url }}" />{% endif %}

    <meta property="og:type" content="article" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description or 'A blog post by Md Abdul Munim' }}" />
    <meta property="og:url" content="https://itsmunim.github.io{{ page.url }}" />
    <meta property="og:site_name" content="Md Abdul Munim" />
    <meta property="og:image" content="https://itsmunim.github.io/images/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:article:published_time" content="{{ date | dateISO }}" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:image" content="https://itsmunim.github.io/images/og-image.png" />

    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon/favicon-16.png" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <meta name="theme-color" content="#05070b" />

    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "headline": "{{ title }}",
      "description": "{{ description or '' }}",
      "datePublished": "{{ date | dateISO }}",
      "url": "https://itsmunim.github.io{{ page.url }}",
      "author": { "@type": "Person", "name": "Md Abdul Munim", "url": "https://itsmunim.github.io/" },
      "publisher": { "@type": "Person", "name": "Md Abdul Munim" },
      "mainEntityOfPage": { "@type": "WebPage", "@id": "https://itsmunim.github.io{{ page.url }}" }
    }
    </script>

    <link rel="stylesheet" href="/styles.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <div class="nav">
          <a class="brand" href="https://itsmunim.github.io/" aria-label="Home">munim<span class="brand-dot">.</span></a>
          <input type="checkbox" id="nav-toggle" class="nav-toggle" />
          <label for="nav-toggle" class="nav-burger" aria-label="Toggle menu">
            <span></span><span></span><span></span>
          </label>
          <nav class="nav-links">
            <a class="nav-link" href="https://itsmunim.github.io/#about">about</a>
            <a class="nav-link" href="https://itsmunim.github.io/#expertise">expertise</a>
            <a class="nav-link" href="https://itsmunim.github.io/#projects">projects</a>
            <a class="nav-link nav-link-active" href="/blog/">blog</a>
            <a class="nav-link nav-cta" href="https://www.linkedin.com/in/munimdibosh/" target="_blank">linkedin</a>
          </nav>
        </div>
        </div>
      </div>
    </header>

    <main>
      <article class="post-article container">
        <header class="post-head">
          <p class="kicker">blog</p>
          <h1 class="post-title">{{ title }}</h1>
          <p class="post-meta">
            <time datetime="{{ date | dateISO }}">{{ date | readableDate }}</time>
          </p>
        </header>
        <div class="post-content">
          {{ content | safe }}
        </div>
      </article>

      <div class="giscus-wrap">
        <script src="https://giscus.app/client.js"
                data-repo="itsmunim/itsmunim.github.io"
                data-repo-id="R_kgDOLUWchQ"
                data-category="Q&A"
                data-category-id="DIC_kwDOLUWchc4DGBnS"
                data-mapping="pathname"
                data-strict="0"
                data-reactions-enabled="1"
                data-emit-metadata="0"
                data-input-position="top"
                data-theme="noborder_gray"
                data-lang="en"
                data-loading="lazy"
                crossorigin="anonymous"
                async>
        </script>
      </div>
      <div class="container post-nav">
        <a href="/blog/" class="social-link">← all posts</a>
      </div>
    </main>

    <footer class="footer" id="contact">
      <div class="container">
        <div class="links">
          <a href="https://www.linkedin.com/in/munimdibosh/" target="_blank" class="social-link">linkedin ↗</a>
          <a href="https://github.com/itsmunim" target="_blank" class="social-link">github ↗</a>
          <a href="https://medium.com/@munimdibosh" target="_blank" class="social-link">medium ↗</a>
          <a href="https://dribbble.com/idibosh" target="_blank" class="social-link">dribbble ↗</a>
        </div>
        <p class="copy">© 2026 Md Abdul Munim — built with a little too much coffee.</p>
      </div>
    </footer>
  </body>
</html>