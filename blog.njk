---
layout: blog-index.njk
permalink: /blog/index.html
title: Blog
---
<div class="blog-list">
{%- for post in collections.post | reverse %}
  <article class="blog-item">
    <time class="blog-date">{{ post.date | readableDate }}</time>
    <h2 class="blog-item-title"><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
    {% if post.data.description %}<p class="blog-item-desc">{{ post.data.description }}</p>{% endif %}
  </article>
{%- endfor %}
</div>